<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Derivative AI — Differentiated Learning</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
<script>
  window.MathJax = {
    tex: { inlineMath: [['$', '$'], ['\\(', '\\)']] },
    svg: { fontCache: 'global' }
  };
</script>
<script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js" async></script>
<style>
/* ========== RESET & BASE ========== */
* { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --bg-dark: #0a0e1a;
  --bg-card: rgba(20, 26, 45, 0.75);
  --border: rgba(120, 140, 200, 0.18);
  --text-primary: #e8ecf7;
  --text-secondary: #9aa5c4;
  --accent-1: #6366f1;
  --accent-2: #8b5cf6;
  --accent-3: #06b6d4;
  --success: #10b981;
  --warning: #f59e0b;
  --radius: 18px;
  --shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
}

body {
  font-family: 'Inter', -apple-system, sans-serif;
  background: var(--bg-dark);
  color: var(--text-primary);
  min-height: 100vh;
  overflow-x: hidden;
  position: relative;
  line-height: 1.6;
}

/* ========== BACKGROUND ========== */
.bg-gradient {
  position: fixed; inset: 0;
  background:
    radial-gradient(circle at 15% 20%, rgba(99, 102, 241, 0.22), transparent 45%),
    radial-gradient(circle at 85% 30%, rgba(139, 92, 246, 0.20), transparent 50%),
    radial-gradient(circle at 50% 90%, rgba(6, 182, 212, 0.16), transparent 55%);
  z-index: -2;
  animation: pulseBg 12s ease-in-out infinite alternate;
}
@keyframes pulseBg {
  0%   { opacity: 0.8; transform: scale(1); }
  100% { opacity: 1;   transform: scale(1.05); }
}
.bg-grid {
  position: fixed; inset: 0;
  background-image:
    linear-gradient(rgba(120, 140, 200, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(120, 140, 200, 0.045) 1px, transparent 1px);
  background-size: 42px 42px;
  z-index: -1;
  mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
}

/* ========== HEADER ========== */
.header { text-align: center; padding: 56px 20px 24px; }
.logo { display: inline-flex; align-items: center; gap: 12px; margin-bottom: 10px; }
.logo-icon {
  font-size: 40px;
  background: linear-gradient(135deg, var(--accent-1), var(--accent-3));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 700;
  filter: drop-shadow(0 0 20px rgba(99, 102, 241, 0.5));
}
.logo-text {
  font-size: 28px; font-weight: 700; letter-spacing: -0.5px;
  background: linear-gradient(135deg, #fff, #a5b4fc);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.tagline { color: var(--text-secondary); font-size: 15px; }

/* ========== CONTAINER ========== */
.container {
  max-width: 920px; margin: 0 auto;
  padding: 20px 24px 80px;
  display: flex; flex-direction: column; gap: 28px;
}

/* ========== CORE PROBLEM ========== */
.core-problem {
  background: var(--bg-card);
  backdrop-filter: blur(20px);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 32px; text-align: center;
  box-shadow: var(--shadow);
  position: relative; overflow: hidden;
}
.core-problem::before {
  content: ''; position: absolute;
  top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, transparent, var(--accent-1), var(--accent-3), transparent);
}
.badge {
  display: inline-block; padding: 5px 14px;
  font-size: 11px; font-weight: 600; letter-spacing: 1.2px;
  text-transform: uppercase; color: var(--accent-3);
  background: rgba(6, 182, 212, 0.12);
  border: 1px solid rgba(6, 182, 212, 0.3);
  border-radius: 999px; margin-bottom: 14px;
}
.core-problem h2 { font-size: 16px; font-weight: 400; color: var(--text-secondary); margin-bottom: 16px; }
.math-display { font-size: 30px; color: #fff; padding: 12px 0; overflow-x: auto; }

/* ========== LEVEL SELECTOR ========== */
.level-selector h3 {
  font-size: 15px; font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 16px; text-align: center;
}
.levels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.level-btn {
  background: var(--bg-card);
  backdrop-filter: blur(16px);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 22px 16px; cursor: pointer;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  color: var(--text-primary); font-family: inherit;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.level-btn:hover {
  transform: translateY(-4px);
  border-color: rgba(139, 92, 246, 0.5);
  box-shadow: 0 15px 40px rgba(99, 102, 241, 0.18);
}
.level-btn.active {
  border-color: var(--accent-2);
  background: linear-gradient(160deg, rgba(99, 102, 241, 0.20), rgba(139, 92, 246, 0.10));
  box-shadow: 0 0 0 1px var(--accent-2), 0 15px 40px rgba(139, 92, 246, 0.28);
}
.level-icon { font-size: 30px; }
.level-name { font-size: 16px; font-weight: 600; }
.level-desc { font-size: 12px; color: var(--text-secondary); text-align: center; }

/* ========== ACTIONS ========== */
.actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
.btn-primary, .btn-secondary {
  font-family: inherit; font-size: 15px; font-weight: 600;
  padding: 14px 30px; border-radius: 12px; border: none;
  cursor: pointer; display: inline-flex; align-items: center; gap: 10px;
  transition: all 0.25s ease;
}
.btn-primary {
  background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
  color: #fff;
  box-shadow: 0 10px 30px rgba(99, 102, 241, 0.4);
}
.btn-primary:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 14px 38px rgba(99, 102, 241, 0.55);
}
.btn-primary:disabled { opacity: 0.7; cursor: not-allowed; }
.btn-secondary {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border);
  color: var(--text-primary);
}
.btn-secondary:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.1);
  border-color: var(--accent-2);
}
.btn-secondary:disabled { opacity: 0.4; cursor: not-allowed; }

/* ========== OUTPUT ========== */
.output {
  background: var(--bg-card);
  backdrop-filter: blur(20px);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 34px; box-shadow: var(--shadow);
  min-height: 200px;
  animation: fadeIn 0.5s ease;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}
.placeholder { text-align: center; color: var(--text-secondary); padding: 40px 20px; }
.placeholder-icon { font-size: 44px; margin-bottom: 14px; opacity: 0.6; }
.output h4 {
  font-size: 13px; text-transform: uppercase; letter-spacing: 1.4px;
  font-weight: 600; margin-bottom: 14px; padding-bottom: 10px;
  border-bottom: 1px solid var(--border);
}
.output.foundation h4 { color: var(--success); }
.output.standard h4   { color: var(--accent-3); }
.output.advanced h4   { color: var(--warning); }
.output .section { margin-bottom: 24px; }
.output .section-title {
  font-size: 14px; font-weight: 600; color: #fff;
  margin-bottom: 10px; display: flex; align-items: center; gap: 8px;
}
.output .problem-text {
  font-family: 'JetBrains Mono', monospace;
  background: rgba(0, 0, 0, 0.25);
  border-left: 3px solid var(--accent-1);
  padding: 14px 18px; border-radius: 8px;
  font-size: 15px; color: #e0e7ff; overflow-x: auto;
}
.output ol, .output ul { padding-left: 22px; color: var(--text-primary); }
.output li { margin-bottom: 8px; font-size: 15px; }
.output .hint-box {
  background: rgba(245, 158, 11, 0.08);
  border: 1px solid rgba(245, 158, 11, 0.28);
  border-radius: 10px; padding: 14px 18px;
  margin-top: 10px; color: #fcd34d; font-size: 14px;
}
.output .answer-box {
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.32);
  border-radius: 10px; padding: 16px 20px;
  font-size: 17px; font-weight: 600; color: #6ee7b7;
  font-family: 'JetBrains Mono', monospace; text-align: center;
}

/* ========== FOOTER ========== */
.footer { text-align: center; padding: 30px 20px 40px; color: var(--text-secondary); font-size: 13px; }

/* ========== RESPONSIVE ========== */
@media (max-width: 640px) {
  .levels { grid-template-columns: 1fr; }
  .math-display { font-size: 22px; }
  .container { padding: 16px; }
  .output, .core-problem { padding: 22px; }
  .btn-primary, .btn-secondary { width: 100%; justify-content: center; }
}
</style>
</head>
<body>

<div class="bg-gradient"></div>
<div class="bg-grid"></div>

<header class="header">
  <div class="logo">
    <span class="logo-icon">∫</span>
    <span class="logo-text">DerivativeAI</span>
  </div>
  <p class="tagline">Personalized calculus learning · 3 difficulty levels</p>
</header>

<main class="container">

  <section class="core-problem">
    <span class="badge">Core Problem</span>
    <h2>Find the derivative of</h2>
    <div class="math-display">$$ f(x) = x^{2} + 3x $$</div>
  </section>

  <section class="level-selector">
    <h3>Choose your difficulty level</h3>
    <div class="levels">
      <button class="level-btn" data-level="foundation">
        <span class="level-icon">🌱</span>
        <span class="level-name">Foundation</span>
        <span class="level-desc">Step-by-step guidance</span>
      </button>
      <button class="level-btn active" data-level="standard">
        <span class="level-icon">⚡</span>
        <span class="level-name">Standard</span>
        <span class="level-desc">Grade-level practice</span>
      </button>
      <button class="level-btn" data-level="advanced">
        <span class="level-icon">🔥</span>
        <span class="level-name">Advanced</span>
        <span class="level-desc">Real-world challenge</span>
      </button>
    </div>
  </section>

  <section class="actions">
    <button id="generateBtn" class="btn-primary">
      <span id="generateText">Show Problem</span>
    </button>
    <button id="hintBtn" class="btn-secondary" disabled>💡 Get a Hint</button>
  </section>

  <section class="output" id="output">
    <div class="placeholder">
      <div class="placeholder-icon">📘</div>
      <p>Select a level and click <strong>Show Problem</strong> to begin.</p>
    </div>
  </section>

</main>

<footer class="footer">
  <p>Built for differentiated learning · Derivative topic</p>
</footer>

<script>
/* ============================================================
   Derivative AI — Differentiated Learning (No API needed)
   All 3 levels use pre-written, verified content.
   ============================================================ */

let currentLevel = "standard";
let currentProblem = null;

// ============ LEVEL DATA (pre-verified, no API) ============
const LEVEL_DATA = {
  foundation: {
    concept: "A derivative tells us how fast something is changing — like the slope of a curve at a point.",
    problem: "Find the derivative of f(x) = x² + 3x.",
    steps: [
      "The derivative of x² uses the power rule: bring the exponent 2 down, then subtract 1 from it → 2x.",
      "The derivative of 3x: the power of x is 1, so it becomes 3 × 1 = 3.",
      "The derivative of a sum is the sum of derivatives.",
      "So f'(x) = 2x + 3."
    ],
    hints: [
      "   For x², multiply by the exponent 2 and reduce the power by 1.",
 ],
      "The derivative of 3x is just the constant    3."
    ],
    answer: " answerf'(x) = 2x +: 3"
  },
  standard: {
    concept: " "Apply the power rule, sum rule, and constant multiple rule to differentiate each term.",
    problem: "Differentiate f(x) = x² + 3x.",
    steps: [
      "d/dx(x²) = 2x  (power rule)",
      "d/dx(3x) = 3   (constant multiple rule)",
      "f'(x) = 2x + 3 (sum rule)"
    ],
    hints: [
      "Differentiate each term separately using the power rule."
f'(x) = 2x + 3"
  },
  advanced: {
    concept: "Kinematics: velocity is the first derivative of position, acceleration is the second derivative.",
    problem: "A particle moves along a straight line. Its position (in meters) at time t (in seconds) is: s(t) = t³ − 6t² + 9t. Find (a) velocity v(t), (b) acceleration a(t), (c) when the particle is at rest.",
    steps: [
      "Velocity = first derivative: v(t) = s'(t) = 3t² − 12t + 9",
      "Acceleration = second derivative: a(t) = v'(t) = 6t − 12",
      "At rest → v(t) = 0: 3t² − 12t + 9 = 0",
      "Divide by 3: t² − 4t + 3 = 0",
      "Factor: (t − 1)(t − 3) = 0  →  t = 1 s and t = 3 s"
    ],
    hints: [],
    answer: "v(t) = 3t² − 12t + 9;  a(t) = 6t − 12;  at rest at t = 1 s and t = 3 s"
  }
};

// ============ DOM ============
const levelButtons = document.querySelectorAll(".level-btn");
const generateBtn  = document.getElementById("generateBtn");
const hintBtn      = document.getElementById("hintBtn");
const output       = document.getElementById("output");

// ============ LEVEL SELECTION ============
levelButtons.forEach(btn => {
  btn.addEventListener("click", () => {
    levelButtons.forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    currentLevel = btn.dataset.level;
  });
});

// ============ SHOW PROBLEM ============
generateBtn.addEventListener("click", () => {
  const data = LEVEL_DATA[currentLevel];
  currentProblem = data;
  renderOutput(data, currentLevel);
  hintBtn.disabled = !data.hints || data.hints.length === 0;
  if (window.MathJax && window.MathJax.typesetPromise) {
    window.MathJax.typesetPromise();
  }
});

// ============ HINT BUTTON ============
hintBtn.addEventListener("click", () => {
  if (!currentProblem || !currentProblem.hints || currentProblem.hints.length === 0) return;
  const hintBox = document.createElement("div");
  hintBox.className = "hint-box";
  const randomHint = currentProblem.hints[Math.floor(Math.random() * currentProblem.hints.length)];
  hintBox.textContent = "💡 " + randomHint;
  output.appendChild(hintBox);
});

// ============ RENDER ============
function renderOutput(data, level) {
  const levelTitles = {
    foundation: "🌱 Foundation Level",
    standard:   "⚡ Standard Level",
    advanced:   "🔥 Advanced Level"
  };

  output.className = `output ${level}`;
  let html = `<h4>${levelTitles[level]}</h4>`;

  if (data.concept) {
    html += `<div class="section"><div class="section-title">📖 Concept</div><p>${escapeHtml(data.concept)}</p></div>`;
  }
  if (data.problem) {
    html += `<div class="section"><div class="section-title">📝 Problem</div><div class="problem-text">${escapeHtml(data.problem)}</div></div>`;
  }
  if (data.steps && data.steps.length) {
    html += `<div class="section"><div class="section-title">🧮 Solution Steps</div><ol>${data.steps.map(s => `<li>${escapeHtml(s)}</li>`).join("")}</ol></div>`;
  }
  if (data.hints && data.hints.length) {
    html += `<div class="section"><div class="section-title">💡 Hints Available</div>`;
    data.hints.forEach(h => { html += `<div class="hint-box">${escapeHtml(h)}</div>`; });
    html += `</div>`;
  }
  if (data.answer) {
    html += `<div class="section"><div class="section-title">✅ Final Answer</div><div class="answer-box">${escapeHtml(data.answer)}</div></div>`;
  }

  output.innerHTML = html;
}

// ============ UTILS ============
function escapeHtml(str) {
  return String(str)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}
</script>
</body>
</html>
